--RULE--
call.is_resource_on_object
--CLAIM--
{ "changed_in": "8.0" }
--CODE--
<?php
function unpack_chunk( $data ) {
	$context = inflate_init( ZLIB_ENCODING_DEFLATE );

	if ( ! is_resource( $context ) ) {
		return 'no context';
	}

	return inflate_add( $context, $data, ZLIB_FINISH );
}

echo unpack_chunk( gzcompress( 'hello' ) ), "\n";
--FIXED--
<?php
function unpack_chunk( $data ) {
	$context = inflate_init( ZLIB_ENCODING_DEFLATE );

	if ( ! ( false !== $context ) ) {
		return 'no context';
	}

	return inflate_add( $context, $data, ZLIB_FINISH );
}

echo unpack_chunk( gzcompress( 'hello' ) ), "\n";
