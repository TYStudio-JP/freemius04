<?php
class Runner {
	public static function pick( $a = 0, $b = 0 ) {
		return false;
	}

	public function run() {
		return iterator_apply( new ArrayIterator( array( 1 ) ), 'self::pick' );
	}
}

echo json_encode( ( new Runner() )->run() ), "\n";
