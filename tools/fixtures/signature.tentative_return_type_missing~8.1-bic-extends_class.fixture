<?php
class Upper_Iterator extends ArrayIterator {
	public function current() {
		return strtoupper( parent::current() );
	}
}

foreach ( new Upper_Iterator( array( 'a', 'b' ) ) as $value ) {
	echo $value, "\n";
}
