--RULE--
class.interface_constant_visibility
--CLAIM--
{ "breaks_in": "8.3" }
--CODE--
<?php
// The constant comes from an interface that the implemented interface extends.
if ( PHP_VERSION_ID >= 80100 ) {
	interface Has_Limit {
		const LIMIT = 10;
	}

	interface Has_Small_Limit extends Has_Limit {
	}

	class Small_Limit implements Has_Small_Limit {
		private const LIMIT = 5;
	}
}

echo "loaded\n";
