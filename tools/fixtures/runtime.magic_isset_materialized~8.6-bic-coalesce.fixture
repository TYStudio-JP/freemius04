--RULE--
runtime.magic_isset_materialized
--CLAIM--
{ "changed_in": "8.6" }
--CODE--
<?php
class Upgw86_Lazy {
	public $p;
	public function __construct() { unset( $this->p ); }
	public function __isset( $name ) { $this->$name = 'written'; return true; }
	public function __get( $name ) { return 'from-get'; }
}
// 7.4-8.5 call __get() after __isset() wrote the property; 8.6 returns "written".
$lazy = new Upgw86_Lazy();
echo $lazy->p ?? 'default', "\n";
