--CODE--
<?php
function plugin_error_handler( $number, $message ) {
	if ( error_reporting() == 0 ) {
		echo 'silenced', "\n";
		return true;
	}

	echo 'reported: ', $message, "\n";
	return true;
}

set_error_handler( 'plugin_error_handler' );

$value = @$undefined_variable;
echo 'done', "\n";
