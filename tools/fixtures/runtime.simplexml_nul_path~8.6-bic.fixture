--RULE--
runtime.simplexml_nul_path
--CLAIM--
{ "breaks_in": "8.6" }
--CODE--
<?php
$file = sys_get_temp_dir() . '/upgw86.xml';
file_put_contents( $file, '<r>ok</r>' );
// With $dataIsURL, 7.4-8.5 cut the path at the NUL byte and load the file.
$xml = new SimpleXMLElement( $file . "\0junk", 0, true );
echo $xml, "\n";
