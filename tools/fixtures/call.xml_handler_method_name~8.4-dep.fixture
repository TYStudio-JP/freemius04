--RULE--
call.xml_handler_method_name
--CLAIM--
{ "deprecated_in": "8.4" }
--CODE--
<?php
class Feed_Reader {
	public $tags = array();

	public function open( $parser, $name, $attributes ) {
		$this->tags[] = $name;
	}

	public function close( $parser, $name ) {
	}
}

$reader = new Feed_Reader();
$parser = xml_parser_create();

// Called through a variable so that this fixture shows the handler names
// alone; xml_set_object() by name is the catalog's own finding.
$attach = 'xml_set_object';
$attach( $parser, $reader );

xml_set_element_handler( $parser, 'open', 'close' );
xml_parse( $parser, '<a><b/></a>', true );

echo implode( ',', $reader->tags ), "\n";
