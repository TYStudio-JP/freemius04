--RULE--
runtime.sqlite3_enable_exceptions_false
--CLAIM--
{ "deprecated_in": "8.3" }
--CODE--
<?php
function open_database( $strict ) {
	$database = new SQLite3( ':memory:' );
	$database->enableExceptions( $strict );

	return $database;
}

echo open_database( false )->querySingle( 'SELECT 1 + 1' ), "\n";
