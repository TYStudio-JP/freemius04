--RULE--
argument.password_hash_salt
--CLAIM--
{ "deprecated_in": "7.4", "changed_in": "8.0" }
--CODE--
<?php
$salt = 'abcdefghijklmnopqrstuu';
$hash = password_hash( 'secret', PASSWORD_BCRYPT, array( 'salt' => $salt, 'cost' => 4 ) );

echo crypt( 'secret', '$2y$04$' . $salt ) === $hash ? "the given salt was used\n" : "a generated salt was used\n";
