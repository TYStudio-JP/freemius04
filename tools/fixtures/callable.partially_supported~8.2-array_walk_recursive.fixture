<?php
class Runner {
	public static function pick( $a = 0, $b = 0 ) {
		return false;
	}

	public function run() {
		$list = array( array( 1 ) ); array_walk_recursive( $list, 'self::pick' ); return "walked";
	}
}

echo json_encode( ( new Runner() )->run() ), "\n";
