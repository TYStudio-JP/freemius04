--RULE--
call.stream_context_set_option_two_arguments
--CLAIM--
{ "deprecated_in": "8.4" }
--CODE--
<?php
$context = stream_context_create();

stream_context_set_option( $context, array( 'http' => array( 'method' => 'POST' ) ) );

$options = stream_context_get_options( $context );
echo $options['http']['method'], "\n";
