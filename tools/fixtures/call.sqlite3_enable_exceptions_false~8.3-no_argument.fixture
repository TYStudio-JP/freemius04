--RULE--
call.sqlite3_enable_exceptions_false
--CLAIM--
{ "deprecated_in": "8.3" }
--CODE--
<?php
// The notes name enableExceptions( false ); without an argument the default is
// false, and the 8.3 runtime raises the same deprecation.
$database = new SQLite3( ':memory:' );
$database->enableExceptions();
echo $database->querySingle( 'SELECT 1 + 1' ), "\n";
