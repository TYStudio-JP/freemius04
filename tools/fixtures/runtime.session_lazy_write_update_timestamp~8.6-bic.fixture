--RULE--
runtime.session_lazy_write_update_timestamp
--CLAIM--
{ "changed_in": "8.6" }
--CODE--
<?php
class Upgw86_Handler implements SessionHandlerInterface, SessionUpdateTimestampHandlerInterface {
	public function open( $path, $name ): bool { return true; }
	public function close(): bool { return true; }
	public function read( $id ): string { return ''; }
	public function write( $id, $data ): bool { echo "write\n"; return true; }
	public function destroy( $id ): bool { return true; }
	#[ReturnTypeWillChange]
	public function gc( $max ) { return 0; }
	public function validateId( $id ): bool { return true; }
	public function updateTimestamp( $id, $data ): bool { echo "updateTimestamp\n"; return true; }
}
ini_set( 'session.use_cookies', '0' );
ini_set( 'session.lazy_write', '1' );
session_set_save_handler( new Upgw86_Handler(), false );
session_id( 'upgw86' );
session_start();
// Empty when read and when written: 7.4-8.5 call write(), 8.6 updateTimestamp().
session_write_close();
