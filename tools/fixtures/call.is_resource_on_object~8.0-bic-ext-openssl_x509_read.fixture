<?php
function read_certificate( $pem ) {
	$certificate = openssl_x509_read( $pem );

	if ( ( false !== $certificate ) ) {
		$fields = openssl_x509_parse( $certificate );

		return 'issued to ' . $fields['subject']['CN'];
	}

	return 'not a certificate';
}

$pem = <<<PEM
