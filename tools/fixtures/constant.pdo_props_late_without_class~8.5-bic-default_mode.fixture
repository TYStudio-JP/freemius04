--RULE--
constant.pdo_props_late_without_class
--CLAIM--
{ "breaks_in": "8.5" }
--CODE--
<?php
// The attribute is accepted; the ValueError comes at the next fetch.
$db = new PDO( 'sqlite::memory:' );
$db->setAttribute( PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_BOTH | PDO::FETCH_PROPS_LATE );
$statement = $db->query( 'SELECT 1 AS a' );
echo count( $statement->fetchAll() ), "\n";
