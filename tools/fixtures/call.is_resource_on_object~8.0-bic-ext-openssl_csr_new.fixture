--FIXED--
<?php
function make_request( $config ) {
	$options = array( 'config' => $config, 'private_key_bits' => 1024 );
	$key     = openssl_pkey_new( $options );
	$request = openssl_csr_new( array( 'commonName' => 'example.org' ), $key, $options );

	return ( false !== $request ) ? 'request created' : 'no request';
}

$config = sys_get_temp_dir() . '/upgw-8-0-bic-ext-openssl.cnf';
file_put_contents( $config, "[req]\ndistinguished_name = dn\n[dn]\n" );
echo make_request( $config ), "\n";
