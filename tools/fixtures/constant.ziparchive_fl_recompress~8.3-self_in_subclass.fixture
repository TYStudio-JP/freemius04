--RULE--
constant.ziparchive_fl_recompress
--CLAIM--
{ "deprecated_in": "8.3" }
--CODE--
<?php
// The constant came with PHP 8.0; on 7.4 the subclass reads its own fallback.
class Archive extends ZipArchive {
	public function recompress_flag() {
		return defined( 'ZipArchive::FL_RECOMPRESS' ) ? self::FL_RECOMPRESS : 0;
	}
}

echo ( new Archive() )->recompress_flag() >= 0 ? "done\n" : '';
