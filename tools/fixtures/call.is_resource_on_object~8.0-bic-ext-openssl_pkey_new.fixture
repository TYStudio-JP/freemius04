--FIXED--
<?php
function make_key( $config ) {
	$key = openssl_pkey_new( array( 'config' => $config, 'private_key_bits' => 1024 ) );

	return ( false !== $key ) ? 'key created' : 'no key';
}

$config = sys_get_temp_dir() . '/upgw-8-0-bic-ext-openssl.cnf';
file_put_contents( $config, "[req]\ndistinguished_name = dn\n[dn]\n" );
echo make_key( $config ), "\n";
