<?php
// Encoding still fails on every version; 8.5 adds E_WARNING "Failed to write
// session data. Data contains invalid key", which the claim format does not
// record.
ini_set( 'session.use_cookies', '0' );
ini_set( 'session.save_path', sys_get_temp_dir() );
session_start();
$_SESSION['a|b'] = 1;
$_SESSION['c']   = 2;
var_dump( session_encode() );
