--RULE--
runtime.gd_argument_range
--CLAIM--
{ "breaks_in": "8.4" }
--CODE--
<?php
// imageavif() exists from PHP 8.1 only. A speed above 10 was accepted up to
// 8.3 and is a ValueError from 8.4.
if ( function_exists( 'imageavif' ) ) {
	$image = imagecreatetruecolor( 2, 2 );

	ob_start();
	@imageavif( $image, null, 50, 20 );
	ob_end_clean();
}

echo "done\n";
