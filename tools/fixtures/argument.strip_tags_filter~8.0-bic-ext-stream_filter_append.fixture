<?php
$stream = fopen( 'php://memory', 'w+' );
fwrite( $stream, '<b>bold</b> text' );
rewind( $stream );
stream_filter_append( $stream, 'string.strip_tags' );
echo stream_get_contents( $stream ), "\n";
