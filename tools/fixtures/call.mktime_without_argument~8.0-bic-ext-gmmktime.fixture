--RULE--
call.mktime_without_argument
--CLAIM--
{ "deprecated_in": "7.4", "breaks_in": "8.0" }
--CODE--
<?php
$now = gmmktime();
echo abs( $now - time() ) < 5 ? "the current time\n" : "another time\n";
--FIXED--
<?php
$now = time();
echo abs( $now - time() ) < 5 ? "the current time\n" : "another time\n";
