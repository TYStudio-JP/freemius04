--RULE--
syntax.case_semicolon
--CLAIM--
{ "deprecated_in": "8.5" }
--CODE--
<?php
function word( $number ) {
	switch ( $number ) {
		case 1;
			return 'one';
		case 2;
			return 'two';
		default;
			return 'many';
	}
}

echo word( 1 ), ' ', word( 2 ), ' ', word( 3 ), "\n";
--FIXED--
<?php
function word( $number ) {
	switch ( $number ) {
		case 1:
			return 'one';
		case 2:
			return 'two';
		default:
			return 'many';
	}
}

echo word( 1 ), ' ', word( 2 ), ' ', word( 3 ), "\n";
