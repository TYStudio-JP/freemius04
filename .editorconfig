root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,yml}]
indent_style = space
indent_size = 2

[lib/php-parser/**]
indent_style = unset
trim_trailing_whitespace = unset

[tools/fixtures/*.fixture]
trim_trailing_whitespace = unset
